{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Dashboard",
  "version": "0.1.0",
  "identifier": "com.github.dashboard",
  "build": {
    "beforeDevCommand": "vite dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GitHub Dashboard",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
