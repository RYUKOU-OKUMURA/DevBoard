# GitHub OAuth App Credentials (Development)
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_dev_client_id_here
GITHUB_CLIENT_SECRET=your_dev_client_secret_here

# Session Management
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_random_32_character_session_secret_here
ENCRYPTION_KEY=your_random_32_character_encryption_key_here
