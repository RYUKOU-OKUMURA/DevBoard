# GitHub Personal Access Token (for direct API access)
# トークン作成: https://github.com/settings/tokens/new
# 必要なスコープ: repo (プライベートリポジトリも含める場合)
# このトークンを設定すると、直接GitHub APIを呼び出します（プロキシサーバー不要）
VITE_GITHUB_TOKEN=your_github_token_here

# GitHub API Proxy (optional - トークンがない場合に使用)
# バックエンド側で GitHub API を呼び出すためのプロキシ URL
# VITE_GITHUB_TOKENが設定されている場合、この設定は無視されます
# VITE_API_PROXY_BASE_URL=http://localhost:3000/api

# リポジトリ分類の閾値（日数）
VITE_ACTIVE_THRESHOLD=60
VITE_STALE_THRESHOLD=180

# 保存ビューの最大数
VITE_MAX_SAVED_VIEWS=5
