# GitHub API Token
# Personal Access Token の場合：repo, read:org スコープを持つトークンを作成
# https://github.com/settings/tokens で取得
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# GitHub API Endpoint (オプション、デフォルトは github.com)
# VITE_GITHUB_API_ENDPOINT=https://api.github.com

# リポジトリ分類の閾値（日数）
VITE_ACTIVE_THRESHOLD=60
VITE_STALE_THRESHOLD=180

# 保存ビューの最大数
VITE_MAX_SAVED_VIEWS=5
