# GitHub API Proxy
# バックエンド側で GitHub API を呼び出すためのプロキシ URL
VITE_API_PROXY_BASE_URL=http://localhost:3000/api

# GitHub API Endpoint (バックエンド側での利用を想定)
# VITE_GITHUB_API_ENDPOINT=https://api.github.com

# リポジトリ分類の閾値（日数）
VITE_ACTIVE_THRESHOLD=60
VITE_STALE_THRESHOLD=180

# 保存ビューの最大数
VITE_MAX_SAVED_VIEWS=5
